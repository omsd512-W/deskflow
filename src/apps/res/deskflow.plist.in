<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleExecutable</key>
	<string>@BUNDLE_EXECUTABLE_NAME@</string>
	<key>CFBundleGetInfoString</key>
	<string>@BUNDLE_INFO_STRING@</string>
	<key>CFBundleIconFile</key>
	<string>@BUNDLE_ICON_FILE@</string>
	<key>CFBundleIdentifier</key>
	<string>@BUNDLE_GUI_IDENTIFIER@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLongVersionString</key>
	<string>@CMAKE_PROJECT_VERSION@</string>
	<key>CFBundleName</key>
	<string>@BUNDLE_BUNDLE_NAME@</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@CMAKE_PROJECT_VERSION@</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>@CMAKE_PROJECT_VERSION@</string>
	<key>CSResourcesFileMapped</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>@BUNDLE_COPYRIGHT@</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>

	<!-- Start as an agent so helper binaries in Contents/MacOS/ (e.g. deskflow-core)
	     and hidden-on-start GUI launches never check in as foreground apps and spawn
	     duplicate Dock icons. The GUI switches to Regular when its window is shown. -->
	<key>LSUIElement</key>
	<true/>

	<!-- Prevent macOS from terminating during memory pressure -->
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>

	<!-- Local Lan Entitlements -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>This app uses local network permissions for communication between a Deskflow server and clients.</string>
	<key>com.apple.security.networking.local</key>
	<true/>

	<!-- Audio sharing: deskflow-audio, started by this app, records what the Mac plays -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>Deskflow forwards the sound this Mac plays to the computer with your headset, when you turn on audio sharing.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Deskflow shares this computer's microphone with another Deskflow computer, when you turn on microphone sharing.</string>

	<!-- Accessibility Entitlements -->
	<key>com.apple.security.accessibility</key>
	<array>
		<dict>
			<key>com.apple.security.accessibility.read</key>
			<true/>
			<key>com.apple.security.accessibility.write</key>
			<true/>
			<key>com.apple.security.accessibility.execute</key>
			<true/>
		</dict>
	</array>
</dict>
</plist>
